<div class="swiper-wrapper">


  <div
    class="swiper-page"
    data-controller="swipe"
    data-swipe-url-value="<%= user_vinyls_url %>"
    data-swipe-persona-value="<%= Persona.find(params[:persona_id]).url %>"
    data-swipe-key-value="<%= @persona_key %>"
    data-swipe-secret-value="<%= @secret %>"
      data-swipe-vinyls-value="<%= @vinyls.to_json(only: [:id, :artwork_url, :title, :artist, :year, :genre]) %>">
    <%# <h1 class="h3"></h1>@persona[:title] %>
    <template data-swipe-target="template">
      <%= render "swiper/vinyl_card", vinyl: nil %>
    </template>
    <div class="tinder-container" data-swipe-target="vinylWrapper"></div>
      <p class="text-uppercase mb-5 h6 text-center">Swipe right to add, left to dismiss</p>
    </div>
    <%= render "shared/toast" %>
</div>
