<article class="swiper-sleeve vinyl-card vinyl-card-animation"
         data-discogs-id="<%= vinyl.nil? ? '{{vinylid}}' : vinyl[:discogs_id] %>"
         aria-live="polite">
  <div class="vinyl-artwork-wrap">
    <%= image_tag(vinyl&.dig(:artwork_url).presence || "placeholder.png",
                  alt: "album cover",
                  class: "album-img",
                  data: { swipe_field: "artwork" }) %>
  </div>

  <div class="vinyl-details">
    <h2 data-swipe-field="title"><%= vinyl.nil? ? "{{title}}" : vinyl[:title] %></h2>
    <p data-swipe-field="artist"><%= vinyl.nil? ? "{{artist}}" : vinyl[:artist] %></p>
    <p data-swipe-field="year"><%= vinyl.nil? ? "{{year}}" : vinyl[:year] %></p>
    <p data-swipe-field="genre"><%= vinyl.nil? ? "{{genre}}" : vinyl[:genre] %></p>
  </div>
</article>
