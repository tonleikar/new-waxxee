<%# Depcrecated. Current template in /views/swiper %>
<article class="welcome-vinyl-card is-ready"
         data-controller="vinyl-flip"
         aria-live="polite">
  <div class="vinyl-artwork-wrap">
    <img src="<%= vinyl.artwork_url %>"
         alt="<%= vinyl.title %>"
         class="album-img">
  </div>
  <div class="vinyl-details">
    <h2><%= vinyl.title %></h2>
    <p><%= vinyl.artist.presence || "Unknown artist" %></p>
    <% if vinyl.year_known? %>
      <p><%= vinyl.display_year %></p>
    <% end %>
    <p><%= vinyl.genre.presence || "Unlisted" %></p>
    <% if vinyl.discogs_url.present? %>
      <a href="<%= vinyl.discogs_url %>" target="_blank" rel="noopener noreferrer">
        <%= image_tag("discogs-logo.svg", alt: "Discogs", class: "vinyl-card-logo") %>
      </a>
    <% end %>
  </div>
</article>
